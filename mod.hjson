#the mod name as displayed in-game
displayName: "QRM Java Module"

#the internal name of your mod
name: "jqrmod"
subtitle: "Hex blocks soon | v1"

#your name
author: "Adrift"

#the fully qualified main class of the mod
main: "jqrmod.JQrmod"

#the mod description as seen in the mod dialog
description: "The java module for qr-mod that adds in java stuff. Required as a dependency for qr-mod starting from QRM v8."

#the mod version
version: 1

#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true